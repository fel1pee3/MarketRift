# Apenas desenvolvimento local. Nao usar estas credenciais em producao.
POSTGRES_DB=marketrift
POSTGRES_USER=marketrift
POSTGRES_PASSWORD=marketrift_local_only
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380
EMBEDDING_PROVIDER=controlled
EMBEDDING_INTERNAL_TOKEN=replace-with-a-local-random-token
EMBEDDING_INTERNAL_URL=http://127.0.0.1:8000
# To use real local vectors after explicit installation: EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_PATH=apps/intelligence/.models/multilingual-minilm-l12-v2
DATABASE_ADMIN_URL=postgresql://marketrift:marketrift_local_only@localhost:5433/marketrift
RUNTIME_DB_PASSWORD=runtime_local_only
PROVISION_DB_PASSWORD=auth_local_only
RUNTIME_DATABASE_URL=postgresql://marketrift_api_login:runtime_local_only@localhost:5433/marketrift
PROVISION_DATABASE_URL=postgresql://marketrift_auth_login:auth_local_only@localhost:5433/marketrift
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Analise desabilitada ate configurar um provedor real. Nao coloque chaves no Git.
EXTRACTOR_VERSION=review-issues-v1
ANALYSIS_PROVIDER=disabled
ANALYSIS_MODEL=gpt-5-nano
# Análise paga de B2B importado exige consentimento por fonte e por operação.
B2B_PAID_ANALYSIS_ENABLED=0
# Defina no .env local as tarifas vigentes que você verificou para o modelo escolhido.
# B2B_INPUT_USD_PER_MILLION=
# B2B_OUTPUT_USD_PER_MILLION=
# OPENAI_API_KEY=configure-somente-no-env-local
