# Copie para .env.worker.local; este arquivo e carregado somente por npm run dev:worker.
# Use uma credencial GitHub com acesso de leitura adequado a repositorios publicos.
GITHUB_DISCUSSIONS_TOKEN=

# Credencial específica de syndication fornecida pela G2, se o acordo permitir.
# Não coloque esse valor no .env compartilhado. Sandbox oficial ainda não confirmado.
G2_SYNDICATION_TOKEN=
# Só habilite após ter concessão escrita para o produto e armazenamento.
G2_PRODUCTION_ENABLED=0
