{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReinterpretWebPageJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant_id", "source_id", "snapshot_id", "interpretation_id", "rule_version", "idempotency_key"],
  "properties": {
    "version": { "const": 1 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "format": "uuid" },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "interpretation_id": { "type": "string", "format": "uuid" },
    "rule_version": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "pattern": "^page-reinterpret-[0-9a-f-]+-v1$" }
  }
}
