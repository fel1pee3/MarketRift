{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketrift.dev/contracts/ingest-review-job.v1.schema.json",
  "title": "IngestReviewJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant_id", "import_id", "source_id", "idempotency_key"],
  "properties": {
