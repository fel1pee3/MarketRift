{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketrift.dev/contracts/analyze-document-job.v1.schema.json",
  "title": "AnalyzeDocumentJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant_id", "document_id", "extractor_version", "idempotency_key"],
  "properties": {
    "version": { "const": 1 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "extractor_version": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "idempotency_key": { "type": "string", "pattern": "^analysis-[0-9a-f-]{36}-[a-z0-9-]+$", "maxLength": 130 }
  }
}
