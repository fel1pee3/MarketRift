{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncFeedJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant_id", "source_id", "run_id", "idempotency_key"],
  "properties": {
    "version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "monitor_generation": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^feed-[0-9a-f-]{36}-v1$"}
  }
}
