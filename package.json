{
  "name": "marketrift",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run dev -w @marketrift/api",
    "dev:web": "npm run dev -w @marketrift/web",
    "dev:worker": "node --env-file=.env --env-file-if-exists=.env.worker.local scripts/run-python.mjs worker",
    "build:python:docker": "docker compose -f compose.yaml -f compose.local-python.yaml --profile local-python build worker intelligence-http renderer",
    "dev:python:docker": "docker compose -f compose.yaml -f compose.local-python.yaml --profile local-python up --no-build worker intelligence-http renderer",
    "dev:scheduler": "npm run dev:scheduler -w @marketrift/api",
    "start:scheduler": "node --env-file=.env apps/api/dist/page-scheduler-main.js",
    "dev:intelligence-http": "node --env-file=.env --env-file-if-exists=.env.worker.local scripts/run-python.mjs http",
    "prepare:embeddings": "node --env-file=.env scripts/run-python.mjs prepare-embeddings",
    "eval:retrieval": "node --env-file=.env scripts/run-python.mjs retrieval-eval",
    "label:retrieval": "node --env-file=.env scripts/run-python.mjs retrieval-label",
    "smoke:retrieval": "node --env-file=.env scripts/run-python.mjs local-smoke",
    "eval:analysis:test": "node --env-file=.env scripts/run-python.mjs evaluate test",
    "eval:analysis:openai": "node --env-file=.env scripts/run-python.mjs quality --provider openai",
    "eval:quality": "node --env-file=.env scripts/run-python.mjs quality",
    "eval:steam": "node --env-file=.env scripts/run-python.mjs steam-eval",
    "eval:b2b": "node --env-file=.env scripts/run-python.mjs b2b-eval",
    "build": "npm run build -w @marketrift/api && npm run build -w @marketrift/web",
    "lint": "npm run lint -w @marketrift/api && npm run lint -w @marketrift/web",
    "test": "npm run test -w @marketrift/api",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "test:feed:db": "node --env-file=.env scripts/test-feed-db.mjs",
    "test:feed:docker": "node --env-file=.env scripts/test-feed-docker.mjs",
    "ops:backup:lab": "node scripts/backup/lab.mjs",
    "ops:restore:audit": "node scripts/backup/quarantine.mjs audit",
    "ops:restore:release": "node scripts/backup/quarantine.mjs release",
    "ops:external:preflight": "node scripts/backup/external.mjs preflight",
    "ops:external:verify-receipt": "node scripts/backup/external.mjs verify-receipt",
    "ops:external:publish-backup": "node scripts/backup/external.mjs publish-backup",
    "ops:external:publish-journal": "node scripts/backup/external.mjs publish-journal",
    "test:external": "node scripts/backup/s3-object-lock.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --env-file=.env scripts/e2e.mjs",
    "db:setup": "node --env-file=.env scripts/setup-db.mjs",
    "db:migrate:account": "node --env-file=.env scripts/migrate-account.mjs",
    "db:migrate:analysis": "node --env-file=.env scripts/migrate-analysis.mjs",
    "db:migrate:github": "node --env-file=.env scripts/migrate-github.mjs",
    "db:migrate:steam": "node --env-file=.env scripts/migrate-steam.mjs",
    "db:migrate:web-pages": "node --env-file=.env scripts/migrate-web-pages.mjs",
    "db:migrate:page-monitoring": "node --env-file=.env scripts/migrate-page-monitoring.mjs",
    "db:migrate:github-discussions": "node --env-file=.env scripts/migrate-github-discussions.mjs",
    "db:migrate:b2b-reviews": "node --env-file=.env scripts/migrate-b2b-reviews.mjs",
    "db:migrate:b2b-analysis": "node --env-file=.env scripts/migrate-b2b-analysis.mjs",
    "db:migrate:evidence-chunks": "node --env-file=.env scripts/migrate-evidence-chunks.mjs",
    "db:migrate:retrieval-review": "node --env-file=.env scripts/migrate-retrieval-review.mjs",
    "db:migrate:reviewable-signals": "node --env-file=.env scripts/migrate-reviewable-signals.mjs",
    "db:migrate:signal-reconciliation": "node --env-file=.env scripts/migrate-signal-reconciliation.mjs",
    "db:migrate:source-discovery": "node --env-file=.env scripts/migrate-source-discovery.mjs",
    "db:migrate:discovery-resource-failures": "node --env-file=.env scripts/migrate-discovery-resource-failures.mjs",
    "db:migrate:page-reinterpretation": "node --env-file=.env scripts/migrate-page-reinterpretation.mjs",
    "db:migrate:discovery-search": "node --env-file=.env scripts/migrate-discovery-search.mjs",
    "db:migrate:discovery-classification": "node --env-file=.env scripts/migrate-discovery-classification.mjs",
    "db:migrate:page-scheduler-grant": "node --env-file=.env scripts/migrate-page-scheduler-grant.mjs",
    "db:migrate:action-hypotheses": "node --env-file=.env scripts/migrate-action-hypotheses.mjs",
    "db:migrate:b2b-quality": "node --env-file=.env scripts/migrate-b2b-quality.mjs",
    "db:migrate:b2b-rights-lifecycle": "node --env-file=.env scripts/migrate-b2b-rights-lifecycle.mjs",
    "db:migrate:b2b-rights-scheduler-grant": "node --env-file=.env scripts/migrate-b2b-rights-scheduler-grant.mjs",
    "db:migrate:github-monitoring": "node --env-file=.env scripts/migrate-github-monitoring.mjs",
    "db:migrate:feed-monitoring": "node --env-file=.env scripts/migrate-feed-monitoring.mjs",
    "db:migrate:feed-run-cancellation": "node --env-file=.env scripts/migrate-feed-run-cancellation.mjs",
    "db:migrate:feed-scheduler-error-grant": "node --env-file=.env scripts/migrate-feed-scheduler-error-grant.mjs",
    "db:migrate:individual-public-pages": "node --env-file=.env scripts/migrate-individual-public-pages.mjs",
    "db:migrate:individual-page-origin-reviewer": "node --env-file=.env scripts/migrate-individual-page-origin-reviewer.mjs",
    "db:migrate:rendered-public-page-runs": "node --env-file=.env scripts/migrate-rendered-public-page-runs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sts": "^3.1142.0",
    "@smithy/node-http-handler": "^4.12.1",
    "pg": "^8.16.3"
  }
}
